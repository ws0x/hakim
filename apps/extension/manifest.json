{
  "manifest_version": 3,
  "name": "Hakim: Kindle Reading Intelligence",
  "version": "1.3.0",
  "description": "Direct Kindle to Notion highlight intelligence synchronizer. Zero CLI required.",
  "icons": {
    "16": "dist/assets/icons/icon-16.png",
    "32": "dist/assets/icons/icon-32.png",
    "48": "dist/assets/icons/icon-48.png",
    "128": "dist/assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Hakim: Kindle Reading Intelligence",
    "default_icon": {
      "16": "dist/assets/icons/icon-16.png",
      "32": "dist/assets/icons/icon-32.png",
      "48": "dist/assets/icons/icon-48.png",
      "128": "dist/assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.de/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://api.notion.com/*"
  ]
}
