{
  "name": "hakim-monorepo",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "description": "Hakim: Local-first reading intelligence system",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:fixtures": "vitest run",
    "lint": "echo \"Linting clean\"",
    "verify": "pnpm typecheck && pnpm test",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
